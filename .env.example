# FleetForge OSS — Environment Variables
# Copy this file to .env and fill in your values

# ─── App ──────────────────────────────────────────────────────────────────────
APP_NAME=FleetForge OSS
DEBUG=true
SECRET_KEY=change-this-to-a-256-bit-random-secret-key-in-production

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://fleetforge:password@localhost:5432/fleetforge

# ─── Redis / Celery ───────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── Power BI Embedded (Azure) ────────────────────────────────────────────────
# Leave blank to skip Power BI; fill in for embedded analytics
POWERBI_TENANT_ID=
POWERBI_CLIENT_ID=
POWERBI_CLIENT_SECRET=
POWERBI_WORKSPACE_ID=

# ─── AWS (optional for S3 proof-of-delivery uploads) ─────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=fleetforge-uploads
